# Salin file ini jadi .env dan isi nilainya sebelum menjalankan server

# Port server jalan
PORT=3000

# Kunci rahasia untuk bikin token login (isi string acak panjang, jangan dibagikan)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Email yang otomatis dapat akses Owner (unlimited semua fitur) saat register/login
OWNER_EMAIL=owner@punyakamu.com

# API key untuk fitur Asisten AI, gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nama model Gemini yang dipakai (boleh dikosongkan, defaultnya gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Opsional: kalau nanti mau upgrade ke Claude API (berbayar), isi ini juga
ANTHROPIC_API_KEY=

# Folder tempat menyimpan file hasil download sementara
DOWNLOAD_DIR=./downloads
